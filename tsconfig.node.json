{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "server", "src/lib"],
  // transport.ts ist reiner Browser-Code (WebSocket, location, Capacitor) und
  // wird vom Server nie importiert.
  "exclude": ["src/lib/transport.ts", "src/lib/*.test.ts"]
}
